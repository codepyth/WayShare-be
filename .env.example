# WayShare — environment variable template.
#
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be committed.
# Use a DIFFERENT value for every variable in every environment (dev / staging / prod).
#
# settings.py reads these via django-environ. Phase 0 core variables are in use now;
# later ones are listed ahead of time so the names are agreed.

# ---------------------------------------------------------------- phase 0 — core
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='Secret key will go here'

# true only on a developer machine. Never true in staging or production.
DJANGO_DEBUG="Should be False on Live version"

# Comma-separated. Empty is fine while DEBUG=true.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL, in a UK or EEA region. Optional locally (SQLite is used when empty and DEBUG=true);
# REQUIRED on the server. Neon gives a URL like:
#   postgresql://user:password@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL='Your database URL'

# Swagger UI at /api/docs/. Defaults to the value of DJANGO_DEBUG; set true on the server to share docs.
# API_DOCS_ENABLED=true

# Frontend addresses allowed to call the API with cookies (comma-separated, no trailing slash).
#   e.g. http://localhost:5173,https://wayshare-web.vercel.app
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# The frontend's public address, no trailing slash. Password reset emails link to
# {FRONTEND_URL}/reset-password. Defaults to http://localhost:3000 when empty.
FRONTEND_URL=

# RENDER_EXTERNAL_HOSTNAME is set by Render automatically — never set it yourself.

# Error tracking (provider not yet chosen). Must not log PII or secrets.
ERROR_TRACKING_DSN=

# ---------------------------------------------------------------- phase 1
# Email via Gmail SMTP (password reset now; booking emails later). Leave both empty to print
# emails to the console instead. EMAIL_PASSWORD is a Google App Password (Google account →
# Security → 2-Step Verification → App passwords), never the real account password.
# Note: Render's FREE tier blocks SMTP ports, so this only sends locally or on a paid instance.
EMAIL_USER=
EMAIL_PASSWORD=

# Routing / distance API (provider not yet chosen).
# Supplies distance_miles, which drives the cost-share cap. Phase 1 critical path.
ROUTING_API_KEY=

# Background jobs (runner not yet chosen). Needed for email and request expiry.
REDIS_URL=

# ---------------------------------------------------------------- phase 2
# SMS for phone verification (provider not yet chosen).
SMS_PROVIDER_SID=
SMS_PROVIDER_TOKEN=

# DVLA share-code service, DVSA MOT History API, DVLA vehicle enquiry.
DVLA_API_KEY=
DVSA_MOT_API_KEY=

# ---------------------------------------------------------------- phase 3
# Stripe Connect. Separate keys per environment — a leaked live key is expensive.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- phase 4
# Object storage for handoff photos (provider not yet chosen).
# Photos must not be deletable while a dispute window is open.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
